{
  "name": "be-buttoned-up",
  "version": "0.0.4",
  "description": "Give button dropdown abilities.",
  "keywords": [
    "web components",
    "web component",
    "custom elements",
    "custom element",
    "enhancement",
    "behavior"
  ],
  "main": "be-buttoned-up.js",
  "module": "be-buttoned-up.js",
  "exports": {
    ".": "./be-buttoned-up.js",
    "./be-buttoned-up.js": "./be-buttoned-up.js",
    "./emc.js": "./emc.js",
    "./🗽.js": "./🗽.js"
  },
  "files": [
    "*.js",
    "types.d.ts",
    "README.md"
  ],
  "types": "./types/be-buttoned-up/types.d.ts",
  "dependencies": {
    "be-hive": "0.1.11",
    "mount-observer": "0.1.27",
