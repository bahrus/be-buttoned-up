{
  "name": "be-buttoned-up",
  "version": "0.0.6",
  "description": "Give button dropdown abilities.",
  "keywords": [
    "web components",
    "web component",
    "custom elements",
    "custom element",
    "enhancement",
    "behavior"
  ],
  "main": "be-buttoned-up.js",
  "module": "be-buttoned-up.js",
  "exports": {
    ".": "./be-buttoned-up.js",
    "./be-buttoned-up.js": "./be-buttoned-up.js",
    "./def.js": "./def.js",
    "./emc.json": "./emc.json",
    "./🧥.json": "./🧥.json"
  },
  "files": [
    "*.js",
    "emc.json",
    "🧥.json",
    "README.md"
  ],
  "types": "./types/be-buttoned-up/types.d.ts",
  "dependencies": {
    "assign-gingerly": "0.0.97",
    "be-hive": "0.1.18",
    "mount-observer": "0.1.53",
    "roundabout-lib": "0.0.38"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "spa-ssi": "0.0.28"
  },
  "scripts": {
    "build": "node emc.mjs > emc.json && node 🧥.mjs > 🧥.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-buttoned-up.git"
  },
